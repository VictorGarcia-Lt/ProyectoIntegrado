# Puerto en el que escucha el servidor Express
PORT=3000

# Cadena de conexión a PostgreSQL (formato: postgres://user:pass@host:port/db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jgfrio

# Secreto para firmar el JWT definitivo
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro

# Secreto para firmar el token temporal de 2FA
JWT_TEMP_SECRET=cambia_esto_por_otro_secreto_largo_y_seguro

# Origen permitido por CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Entorno de ejecución: development | production
NODE_ENV=development